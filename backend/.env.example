# For production on Render, see render.yaml at the repo root — it provisions
# the Postgres database and web service, and wires most of these automatically.
NODE_ENV=development
PORT=3000
# This backend's own public origin (no trailing slash). The TikTok / Instagram
# OAuth callback URLs are derived from it, so each environment sends the OAuth
# round trip back to itself. Defaults to http://localhost:<PORT> when unset.
# Local: keep localhost, or set to an `ngrok http 3000` HTTPS origin (also
# registered in the TikTok/Meta portals) to test social-account connect locally.
# Render: https://<your-app>.onrender.com
PUBLIC_BASE_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatormarket
# Optional. Only needed when this backend runs as more than one instance —
# enables Socket.IO's Redis adapter so chat typing/message events broadcast
# across instances instead of only within the process that received them.
# Leave unset for local dev (single process = no adapter needed).
REDIS_URL=
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:5173,http://localhost:3000
# Optional: fatal | error | warn | info | debug | trace (defaults to debug in dev, info in production)
LOG_LEVEL=
# Required for the AI campaign generator (POST /api/campaigns/ai/generate). Get one at platform.openai.com
UNSPLASH_ACCESS_KEY=
OPENAI_API_KEY=
# Sparrow SMS (Nepal) — optional. Until both are set, sendSms() logs instead of sending.
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=
# Cloudinary — required for avatar/logo/document uploads and chat image/file/video attachments
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudflare R2 — primary storage for chat/deliverable video and chat voice
# recordings only. Optional: unset falls back to Cloudinary for those flows.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PRESIGNED_URL_EXPIRY=900
# Khalti ePayment (KPG-2) — business pays to start a paid application. Get keys
# from the Khalti merchant dashboard (test keys for sandbox, live keys for production).
KHALTI_SECRET_KEY=
# https://dev.khalti.com/api/v2 for a test/sandbox key, https://khalti.com/api/v2
# once Khalti approves the merchant account for live keys.
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# Full absolute URL to CampaignController.khaltiCallback — must be publicly
# reachable over HTTPS (Khalti's redirect can't reach localhost).
KHALTI_RETURN_URL=

# Sign in with Apple. APPLE_CLIENT_ID is the iOS Bundle ID and is the only var
# Phase 1 (mobile sign-in) needs — it's the audience the Apple identity token is
# verified against. The .p8 key vars are for later (token revoke / S2S webhooks).
APPLE_CLIENT_ID=com.sundarban.kolab
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the AuthKey_XXXX.p8 file, newlines written as literal \n. Never commit the file itself.
APPLE_PRIVATE_KEY=
