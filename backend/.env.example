# For production on Render, see render.yaml at the repo root — it provisions
# the Postgres database and web service, and wires most of these automatically.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatormarket

# Optional. Needed when this backend runs as more than one instance (Socket.IO
# cross-instance broadcast). Also enables the shared rate-limit store and the
# response cache — both degrade gracefully to per-instance / no-cache when unset.
REDIS_URL=

# Optional. Second, non-evicting Redis for BullMQ job queues, the notification
# queue, the OTP fast path and counters. Fully independent of REDIS_URL — when
# unset, queued work runs inline and OTP verification reads straight from
# Postgres. In production this points at a separate instance (kolab-queue) with
# maxmemory-policy noeviction; BullMQ will not run against an evicting Redis.
REDIS_QUEUE_URL=

# Optional. Per-instance Prisma connection-pool size (default 5). Keep
# instances × limit comfortably under the Postgres connection ceiling.
DB_CONNECTION_LIMIT=
# Optional. Log queries slower than this many ms at warn (non-dev only, default 300).
SLOW_QUERY_LOG_MS=
# Optional. Sentry performance-tracing sample rate 0–1 (default 0 = off). Try 0.1 in prod.
SENTRY_TRACES_SAMPLE_RATE=

JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_SECURE=ssl

FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Optional: fatal | error | warn | info | debug | trace
# Required for the AI campaign generator.
OPENAI_API_KEY=your-openai-api-key

# Sparrow SMS (Nepal) — optional.
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-r2-public-url
R2_PRESIGNED_URL_EXPIRY=900

# Unsplash
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Custom URL scheme
APP_SCHEME=kolab

# Google OAuth
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sign in with Apple
APPLE_CLIENT_ID=com.sundarban.kolab

# Facebook Login
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# TikTok Login Kit
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://your-backend.onrender.com/api/creator/social-accounts/tiktok/callback

# Instagram API with Instagram Login
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://your-backend.onrender.com/api/creator/social-accounts/instagram-login/callback

# Khalti ePayment
KHALTI_SECRET_KEY=your-khalti-secret-key
KHALTI_PUBLIC_KEY=your-khalti-public-key
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_RETURN_URL=http://localhost:3000/api/payments/khalti/callback

# eSewa ePay v2
ESEWA_SECRET_KEY=your-esewa-secret-key
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_BASE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_RETURN_BASE_URL=http://localhost:3000

# Resend
RESEND_API_KEY=your-resend-api-key