# dependencies
node_modules/

# build output
dist/
build/

# environment variables (never commit real secrets — see .env.example)
.env
.env.local
.env.*.local

# payment certificates / private keys (e.g. connectIPS CREDITOR.pfx) — these
# live only in deployment secrets (CONNECTIPS_PRIVATE_KEY), never in git
*.pfx
*.p12
*.pem
*.key

# typescript
*.tsbuildinfo

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# database credentials
pgadmin/pgpassfile

# coverage
coverage/
.nyc_output/

# OS
.DS_Store

# editor
.vscode/*
!.vscode/extensions.json
.idea/
