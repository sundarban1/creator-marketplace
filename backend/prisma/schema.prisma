model Category {
  id           String                @id @default(cuid())
  icon         String
  iconBg       String
  color        String                @default("#6B7280")
  name         String
  key          String                @unique
  scope        CategoryScope         @default(BOTH)
  status       CategoryStatus        @default(ACTIVE)
  // Section header for the provider-type picker (e.g. "Content & Media",
  // "Talent & Appearance") — only meaningful for CREATOR-scope rows; BOTH-scope
  // content-niche rows (Restaurants, Automotive, ...) leave this null, they're
  // not grouped. Also matched by search alongside `name`, since the group is
  // where the umbrella term lives — "music" has to find a DJ, "photography" a
  // Wedding Photographer.
  group        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  services     Service[]
  requirements CampaignRequirement[]

  @@map("categories")
}

enum PlatformStatus {
  ACTIVE
  INACTIVE
}

// Admin-managed source of truth for social platforms (Instagram, TikTok, etc.) —
// referenced by name/key everywhere a platform needs to be selected or displayed
// (campaign creation, creator preferred platforms, social account connections),
// instead of hardcoding the list in every client.
model Platform {
  id        String         @id @default(cuid())
  icon      String
  iconBg    String
  color     String         @default("#6B7280")
  name      String
  key       String         @unique
  status    PlatformStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("platforms")
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
}

// Admin-managed source of truth for payment methods (eSewa, Khalti, Fonepay, ...)
// shown wherever the app needs to collect or display one — creator/business
// payout & payin method pickers, wallet withdrawals, event payment. Only
// ACTIVE rows are offered to the mobile app; disabling one here hides it from
// new selections without touching profiles that already picked it.
model PaymentMethod {
  id        String              @id @default(cuid())
  key       String              @unique
  name      String
  iconUrl   String?
  color     String              @default("#6B7280")
  order     Int                 @default(0)
  status    PaymentMethodStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("payment_methods")
}

enum SuccessStoryStatus {
  ACTIVE
  INACTIVE
}

// Admin-managed testimonials shown on the public landing page's Success
// Stories marquee — only ACTIVE rows are returned by the public endpoint.
model SuccessStory {
  id        String             @id @default(cuid())
  name      String
  role      String
  quote     String
  photoUrl  String?
  order     Int                @default(0)
  status    SuccessStoryStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("success_stories")
}

enum VisitorChatStatus {
  OPEN
  CLOSED
}

enum VisitorMessageSender {
  VISITOR
  ADMIN
}

// Real-time chat between an anonymous website visitor (landing page floating
// widget, identified only by the name/email/phone they give when starting a
// chat — no account, no login) and any admin. Deliberately separate from
// Conversation/Message (creator<->business chat), which requires both sides
// to be authenticated platform users.
model VisitorChat {
  id            String            @id @default(cuid())
  name          String
  email         String?
  phone         String?
  status        VisitorChatStatus @default(OPEN)
  createdAt     DateTime          @default(now())
  lastMessageAt DateTime?
  visitorSeenAt DateTime?
  adminSeenAt   DateTime?
  messages      VisitorMessage[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@map("visitor_chats")
}

model VisitorMessage {
  id        String               @id @default(cuid())
  chatId    String
  sender    VisitorMessageSender
  adminId   String?
  content   String
  createdAt DateTime             @default(now())
  chat      VisitorChat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  admin     User?                @relation(fields: [adminId], references: [id])

  @@index([chatId, createdAt])
  @@map("visitor_messages")
}

// Business activity trail (registrations, applications, payments, ...). No FK to User —
// rows must remain queryable even after the referenced account is deleted.
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  device      String?
  platform    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// Security-sensitive change trail (password resets, verification decisions, suspensions, ...).
// Immutable by convention: no service method ever updates or deletes a row. No FK to User for
// the same reason as ActivityLog.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  oldValue    Json?
  newValue    Json?
  performedBy String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
