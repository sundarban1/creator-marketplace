// A creator's private shortlist of events they want to come back to — the
// creator-side mirror of SavedCreator below (a business saving creators).
// Unrelated to Application.status = SHORTLISTED, which is a business
// shortlisting an applicant: this needs no application to exist and the
// business is never told about it.
model ShortlistedCampaign {
  id         String         @id @default(cuid())
  creatorId  String
  campaignId String
  createdAt  DateTime       @default(now())
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, campaignId])
  @@index([creatorId, createdAt(sort: Desc)])
  @@map("shortlisted_campaigns")
}

model SavedCreator {
  id         String          @id @default(cuid())
  businessId String
  creatorId  String
  createdAt  DateTime        @default(now())
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator    CreatorProfile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([businessId, creatorId])
  @@map("saved_creators")
}

model CampaignInvitation {
  id          String           @id @default(cuid())
  campaignId  String
  creatorId   String
  businessId  String
  message     String?
  status      InvitationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator     CreatorProfile   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
