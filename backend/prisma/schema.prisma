// Aggregated, incrementally-updated stats — kept in sync by analytics.service.ts
// at the exact point each underlying event already happens elsewhere in the
// codebase, so the analytics dashboard never has to re-aggregate raw
// Application/Campaign/Withdrawal rows on every request. profileCompletion
// and referral stats are intentionally NOT stored here — they're cheap to
// compute live (see analytics.service.ts) and storing them risks drift.
model CreatorAnalytics {
  userId                String   @id
  totalProfileViews     Int      @default(0)
  totalEarnings         Float    @default(0)
  pendingEarnings       Float    @default(0)
  invitationsReceived   Int      @default(0)
  applicationsSubmitted Int      @default(0)
  applicationsAccepted  Int      @default(0)
  applicationsRejected  Int      @default(0)
  activeCampaigns       Int      @default(0)
  completedCampaigns    Int      @default(0)
  averageRating         Float    @default(0)
  reviewCount           Int      @default(0)
  responseTimeAvgMins   Float    @default(0)
  responseTimeSamples   Int      @default(0)
  updatedAt             DateTime @updatedAt

  @@map("creator_analytics")
}

model BrandAnalytics {
  userId               String   @id
  campaignsCreated     Int      @default(0)
  activeCampaigns      Int      @default(0)
  completedCampaigns   Int      @default(0)
  totalSpend           Float    @default(0)
  applicationsReceived Int      @default(0)
  creatorsHired        Int      @default(0)
  averageRatingGiven   Float    @default(0)
  ratingsGivenCount    Int      @default(0)
  responseTimeAvgMins  Float    @default(0)
  responseTimeSamples  Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@map("brand_analytics")
}

// §75 — user-filed reports (spam/fraud/harassment/etc.) against any of the
// entity types below. Previously the admin "Reports" page rendered entirely
// from hardcoded mock data (web/src/data/mockData.ts) — this table plus the
// report module is the first time a real reporting pipeline exists at all.
model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      ReportReason
  description String?
  status      ReportStatus     @default(NEW)
  // Set together when an admin moves this off NEW — actionNote is shown back
  // to admins reviewing history, never to the reporter or the reported party.
  reviewedBy  String?
  reviewedAt  DateTime?
  actionNote  String?
  createdAt   DateTime         @default(now())

  reporter User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
  @@map("reports")
}

enum ReportTargetType {
  USER
  BUSINESS
  SERVICE
  OPPORTUNITY
  POST
  MESSAGE
  REVIEW
}

enum ReportReason {
  SPAM
  SCAM
  FRAUD
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  PAYMENT_ISSUE
  OTHER
}

enum ReportStatus {
  NEW
  UNDER_REVIEW
  ACTION_TAKEN
  DISMISSED
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

enum Role {
  CREATOR
  BUSINESS
  ADMIN
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
  EXPIRED
}

enum ConversationStatus {
  PENDING
  ACCEPTED
  DECLINED
  // A collaboration that ran its course — work delivered and payment released.
  // The thread drops out of both inboxes entirely (PENDING would resurface it
  // as a bogus "request"/"pending" row). Accepting a fresh proposal from the
  // same creator flips it back to ACCEPTED and chat resumes; either side can
  // also send a new message request, which re-opens it as PENDING.
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VIDEO
  VOICE
  // §54 — auto-posted at collaboration lifecycle events (work started/
  // submitted, payment released); rendered as a centered, sender-less pill
  // in the mobile chat UI rather than a normal left/right bubble. Still has
  // a real senderId (Message.senderId stays required) — the mobile client
  // ignores it for SYSTEM messages, it's just bookkeeping.
  SYSTEM
}

// Applies to VIDEO attachments/deliverables only (chat: Message.attachmentStatus;
// deliverables: a `status` field inside the deliverableVideos JSON entries, see
// campaign.dto.ts's deliverableVideoSchema). PROCESSING/READY are both set
// synchronously today within the same request that verifies the Cloudinary
// upload — there's no async job yet — but the field exists now so a future
// async moderation/quality-check step can persist PROCESSING and flip it to
// READY/FAILED later without changing the upload architecture. UPLOADING is
// deliberately not a value here: no row/entry exists until Cloudinary has
// already confirmed the asset, same as before this field existed.
enum VideoAssetStatus {
  PROCESSING
  READY
  FAILED
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum ApplicationStatus {
  PENDING
  // §49 — a lightweight "under consideration" marker a business can set on a
  // PENDING application before committing to Accept/Reject; purely additive,
  // doesn't affect capacity enforcement (only ACCEPTED does) or contract
  // signing. Both PENDING and SHORTLISTED can still transition straight to
  // ACCEPTED/REJECTED — updateApplicationStatus never checked prior status.
  SHORTLISTED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum CampaignType {
  PAID_CAMPAIGN
  OPEN_EVENT
}

// Whether a role is completed by performing/attending in person (no file
// upload expected) or by submitting a digital output for review. Drives
// which job-completion UI/flow an Application follows. Nullable — existing
// campaigns predating this field, and any campaign the AI/business hasn't
// classified yet, simply don't branch on it.
enum CompletionType {
  SERVICE
  DELIVERABLE
}

enum LocationType {
  ONSITE
  REMOTE
}

