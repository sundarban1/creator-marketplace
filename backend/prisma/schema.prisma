generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String            @id @default(cuid())
  email                     String            @unique
  password                  String
  role                      Role
  isEmailVerified           Boolean           @default(false)
  isPhoneVerified           Boolean           @default(false)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  phone                     String?           @unique
  isOnboarded               Boolean           @default(false)
  isActive                  Boolean           @default(true)
  // Set only when an admin suspends this account (distinct from a user's own
  // self-deactivation, which also flips isActive false but leaves this null).
  // Login blocks outright when this is set; self-deactivated accounts still
  // auto-reactivate on next login.
  suspendedAt               DateTime?
  // Consecutive failed-password count on login — reset to 0 on a successful
  // login. Drives the admin-configurable CAPTCHA-after-suspicious-behaviour
  // trigger (see AuthService.login); not a lockout by itself.
  failedLoginCount          Int               @default(0)
  lastFailedLoginAt         DateTime?
  // False for accounts created purely through a social provider (Apple/Google) —
  // they hold a random unusable password. Flips true once the user sets one via
  // password reset. Drives the "don't unlink your only login method" guard.
  hasPassword               Boolean           @default(true)
  deviceId                  String?
  // Updated on socket connect/disconnect — drives the chat "Active now" / "Active Xm ago" status.
  lastSeenAt                DateTime?
  // Per-channel opt-out — checked before every push (notification.service.ts
  // sendExpoPush) and every transactional campaign email (campaign.service.ts).
  // Independent of each other; either can be off while the other stays on.
  pushNotificationsEnabled  Boolean           @default(true)
  emailNotificationsEnabled Boolean           @default(true)
  businessProfile           BusinessProfile?
  creatorProfile            CreatorProfile?
  issueReports              IssueReport[]
  sentMessages              Message[]         @relation("MessageSender")
  notifications             Notification[]
  otpVerifications          OtpVerification[]
  supportRequests           SupportRequest[]
  reviewsGiven              Review[]          @relation("ReviewFrom")
  reviewsReceived           Review[]          @relation("ReviewTo")
  visitorMessages           VisitorMessage[]
  blocksMade                Block[]           @relation("BlocksMade")
  blocksReceived            Block[]           @relation("BlocksReceived")
  aiConversations           AiConversation[]
  sessions                  Session[]
  pushTokens                PushToken[]
  reportsFiled              Report[]          @relation("ReportsFiled")
  authAccounts              AuthAccount[]

  @@index([role])
  @@map("users")
}

// One row per external identity a user can authenticate with (Apple, Google,
// Facebook). Email/password stays on `User` itself — this table is for
// provider-issued identities where the stable id (not the email) is canonical.
//
// Apple in particular: Apple's `sub` is the identity, the email can be a
// throwaway `@privaterelay.appleid.com` alias, and the same email may already
// belong to a phone/password account — so we never merge on email, we match on
// (provider, providerUserId).
enum AuthProvider {
  PHONE
  GOOGLE
  APPLE
  FACEBOOK
}

model AuthAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  // Apple `sub`, Google `id`, Facebook `id` — the provider's own stable user id.
  providerUserId String
  // Best-effort: whatever email the provider handed us when the link was made
  // (may be a private-relay alias, may be null). Never used for lookup.
  email          String?
  // Apple's OAuth refresh token from the sign-in authorization-code exchange —
  // the only handle Apple's /auth/revoke endpoint accepts, so it's needed to
  // sever the Apple ↔ Kolab link on account deletion (App Store requirement).
  // Plaintext like SocialAccount.refreshToken; never exposed in any DTO.
  refreshToken   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The one hard guarantee: a given provider identity maps to exactly one Kolab
  // user, and is the race-condition backstop for concurrent first sign-ins.
  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_accounts")
}

// One row per logged-in device — replaces the old single `User.refreshToken`
// column so a login on device B no longer invalidates device A's session.
// Deleted on that device's logout; wiped entirely (all rows for the user) on
// password reset / account deactivation / deletion.
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  deviceId     String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// One row per device's Expo push token — replaces the old single
// `User.pushToken` column so a user logged into multiple devices gets
// pushes on all of them, not just whichever device registered last.
// Cleared per-row (not per-user) when Expo reports DeviceNotRegistered.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  deviceId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// Generic User<->User block, currently only surfaced for creator<->creator
// conversations (see messaging.service.ts assertNotBlocked) — kept generic
// rather than creator-scoped so it can extend to other pairings later
// without another migration.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model CreatorProfile {
  id                       String                  @id @default(cuid())
  userId                   String                  @unique
  fullName                 String?
  bio                      String?
  location                 String?
  avatarUrl                String?
  coverImageUrl            String?
  categories               String[]
  socialLinks              Json                    @default("{}")
  portfolioLinks           Json                    @default("[]")
  isVerified               Boolean                 @default(false)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  username                 String?                 @unique
  paymentMethods           String[]                @default([])
  prefPlatforms            String[]                @default([])
  prefLocations            String[]                @default([])
  prefBudgetMin            Float                   @default(0)
  prefBudgetMax            Float                   @default(500)
  locationLat              Float?
  locationLng              Float?
  nearbyRadiusKm           Int                     @default(25)
  nearbyUseHomeLocation    Boolean                 @default(false)
  referralCode             String?                 @unique
  citizenshipDocUrl        String?
  citizenshipStatus        CitizenshipStatus       @default(NONE)
  citizenshipUploadedAt    DateTime?
  panDocUrl                String?
  panDocStatus             DocumentStatus          @default(NONE)
  panDocUploadedAt         DateTime?
  // Parity with BusinessProfile's equivalent pair, added later — BusinessProfile
  // has always had these, Creator never did until the Provider-marketplace work.
  verificationRejectReason String?
  verificationRejectedAt   DateTime?
  // Structured location — additive alongside the free-text `location` above,
  // which stays authoritative for existing search/display until callers migrate.
  province                 String?
  district                 String?
  city                     String?
  area                     String?
  address                  String?
  locationVisibility       LocationVisibility      @default(CITY)
  // §61 — parity with BusinessProfile's equivalent trio, added later:
  // BusinessProfile has always had these, providers never did until now.
  // The public profile endpoint gates on showPublicProfile the same way
  // business.service.ts's getBusinessPublic already does.
  showPublicProfile        Boolean                 @default(true)
  hideContactDetails       Boolean                 @default(false)
  hideSocialLinks          Boolean                 @default(false)
  availabilityStatus       AvailabilityStatus      @default(AVAILABLE)
  // Collected as the first step of provider onboarding, right after signup.
  providerType             ProviderType?
  // §4 — how many people are in the team. A plain count, not a bucketed enum
  // like BusinessProfile.businessSize: the spec renders it literally ("Team ·
  // 4 members"), which a bucket can't produce. Only meaningful for
  // providerType TEAM — cleared by CreatorService.updateProfile on any switch
  // away from TEAM, the same way business.service.ts clears its
  // ORGANIZATION-only fields.
  teamSize                 Int?
  // §6 — the industries an AGENCY serves (Food & Restaurant, Hospitality,
  // Fashion...). Deliberately separate from `categories`, which holds what the
  // provider DOES (Photographer, Videographer) — the same split
  // BusinessProfile already makes between its industry `categories` and
  // `defaultCreatorCategories`. AGENCY-only: cleared by
  // CreatorService.updateProfile on any switch away, like teamSize above.
  industries               String[]                @default([])
  // §5 step 2 — an AGENCY's legal identifiers. Never public (a PAN is not
  // public data): private DTO only, used for verification and payouts.
  // AGENCY-only on write, but deliberately NOT wiped when the provider type
  // changes, unlike teamSize/industries above — those two are presentation
  // fields that would display wrongly for the new type, while these are
  // records of fact that stay true and back a verification decision.
  panNo                    String?
  vatNo                    String?
  companyRegNo             String?
  // §3 step 4 — where this provider delivers. Distinct from Campaign's
  // ONSITE/REMOTE LocationType, which describes what a job requires: that
  // 2-value enum can't express "at my location" (a salon, a studio) versus
  // "at the client's" (a mobile makeup artist), which is exactly the
  // distinction the spec asks providers for.
  serviceMode              ServiceMode?
  // §5 step 1 — a provider's own site. Public like socialLinks (and hidden by
  // the same hideSocialLinks toggle), not a private contact detail.
  website                  String?
  // §5 — an AGENCY's business-registration document, the provider-side mirror
  // of BusinessProfile.companyRegDoc*. Optional: it gates the verified badge
  // for an agency, never profile creation (§18).
  companyRegDocUrl         String?
  companyRegDocStatus      DocumentStatus          @default(NONE)
  companyRegDocUploadedAt  DateTime?
  // What this provider charges, distinct from prefBudgetMin/Max above (what
  // they're willing to accept on a campaign).
  startingRate             Float?
  negotiable               Boolean                 @default(true)
  applications             Application[]
  conversations            Conversation[]          @relation("CreatorConversations")
  conversationsAsCreator2  Conversation[]          @relation("Creator2Conversations")
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteBusinesses       FavoriteBusiness[]
  shortlistedCampaigns     ShortlistedCampaign[]
  socialAccounts           SocialAccount[]
  savedBy                  SavedCreator[]
  receivedInvitations      CampaignInvitation[]
  referralsMade            Referral[]              @relation("ReferralsMade")
  referralsReceived        Referral?               @relation("ReferralsReceived")
  withdrawals              Withdrawal[]
  payoutMethods            PayoutMethod[]
  walletTransactions       WalletTransaction[]
  profileViews             ProfileView[]
  paymentTransactions      PaymentTransaction[]
  contracts                Contract[]
  services                 Service[]
  portfolioItems           PortfolioItem[]
  availabilitySchedule     AvailabilitySchedule[]
  serviceRequests          ServiceRequest[]
  members                  ProviderMember[]        @relation("ProviderMembers")
  assignedWork             ApplicationAssignment[] @relation("AssignedWork")
  memberOf                 ProviderMember[]        @relation("ProviderMemberships")

  @@index([isVerified])
  @@map("creator_profiles")
}

// A sellable offering a provider lists (§14 of the Provider marketplace spec)
// — distinct from CreatorProfile.categories (what they generally do) and from
// Campaign (what a business is hiring for). categoryId is a real FK, unlike
// the legacy CreatorProfile.categories/Campaign.category string arrays, since
// this is a new table with no existing data to preserve compatibility with.
model Service {
  id               String           @id @default(cuid())
  creatorProfileId String
  categoryId       String
  name             String
  description      String
  startingPrice    Float?
  pricingModel     PricingModel
  deliveryTime     String?
  whatsIncluded    String[]         @default([])
  status           ServiceStatus    @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  creatorProfile   CreatorProfile   @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  category         Category         @relation(fields: [categoryId], references: [id])
  requests         ServiceRequest[]

  @@index([creatorProfileId])
  @@index([categoryId])
  @@map("services")
}

// A business directly asking a provider about one of their listed Services
// (§33/34) — distinct from the Opportunity/Application flow (CampaignRequirement),
// which is for businesses posting a role and providers applying to it. Here the
// business initiates, targeting one specific provider's specific service.
// Deliberately lightweight: PENDING → ACCEPTED/DECLINED only — once accepted,
// the two parties continue over regular messaging rather than a tracked
// deliverables/payment lifecycle like Application has (that's the Opportunity
// flow's job; a Service inquiry is closer to an initial conversation starter).
model ServiceRequest {
  id          String               @id @default(cuid())
  serviceId   String
  businessId  String
  creatorId   String
  message     String
  budget      Float?
  status      ServiceRequestStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator  CreatorProfile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([creatorId, status])
  @@map("service_requests")
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Structured portfolio entries, additive alongside CreatorProfile.portfolioLinks
// (unstructured Json, still read by existing code) — new uploads should prefer
// this table; the Json field is not being migrated or deprecated here.
model PortfolioItem {
  id               String         @id @default(cuid())
  creatorProfileId String
  title            String?
  description      String?
  category         String?
  mediaUrl         String?
  mediaType        MediaType?
  externalUrl      String?
  createdAt        DateTime       @default(now())
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId])
  @@map("portfolio_items")
}

// §4/§7 — one membership table for both TEAM and AGENCY, per the spec's rule
// that provider types share a common model rather than getting parallel ones.
// The two role axes are deliberately separate: `jobRole` is what the person
// does on a booking (Photographer, Editor, DJ...), `accessRole` is what they
// can do inside Kolab (§7's Owner/Admin/Manager/Member). A team that never
// thinks about permissions just leaves every member on the MEMBER default.
//
// Name, photo and skills are NOT duplicated here — they live on the member's
// own CreatorProfile, so a member who updates their profile updates it
// everywhere they appear. V1 therefore only invites people who already have a
// Kolab provider account; inviting a stranger by bare phone number would have
// nothing to attach the membership to until they signed up.
// §13/§16 — which members are working a booking the team or agency won.
//
// Ownership itself needs no new model: a TEAM/AGENCY *is* a CreatorProfile, so
// an Application it wins already belongs to it, the review already targets its
// user (analytics.service.ts resolves toUserId from application.creator), and
// the payout already goes to its profile. This table only records who inside
// the team is doing the work — it deliberately carries no money, so §15's "no
// automatic payment splitting in V1" stays true by construction.
model ApplicationAssignment {
  id            String   @id @default(cuid())
  applicationId String
  memberId      String
  note          String?
  assignedAt    DateTime @default(now())

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  member      CreatorProfile @relation("AssignedWork", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([applicationId, memberId])
  @@index([memberId, assignedAt(sort: Desc)])
  @@map("application_assignments")
}

model ProviderMember {
  id          String             @id @default(cuid())
  providerId  String
  memberId    String
  jobRole     String?
  accessRole  ProviderMemberRole @default(MEMBER)
  // §4 — "The invited person must accept the invitation before becoming an
  // active team member", so a row exists while still PENDING and only counts
  // as active once ACCEPTED.
  status      InvitationStatus   @default(PENDING)
  invitedAt   DateTime           @default(now())
  respondedAt DateTime?

  provider CreatorProfile @relation("ProviderMembers", fields: [providerId], references: [id], onDelete: Cascade)
  member   CreatorProfile @relation("ProviderMemberships", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([providerId, memberId])
  @@index([memberId, status])
  @@map("provider_members")
}

enum ProviderMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

// Optional weekly availability, separate from the coarse availabilityStatus
// enum on CreatorProfile (available/busy/unavailable "right now" vs. a
// recurring schedule).
model AvailabilitySchedule {
  id               String         @id @default(cuid())
  creatorProfileId String
  dayOfWeek        Int
  availableFrom    String
  availableUntil   String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([creatorProfileId, dayOfWeek])
  @@map("availability_schedules")
}

// A manual creator payout request (Kolab V1 — no automated payout APIs). The
// creator submits it; the amount is *reserved* (not deducted) while status is
// PENDING/PROCESSING; an admin transfers the money out-of-band and then marks it
// PAID, which is the only point the wallet is permanently debited (see
// WalletTransaction). REJECTED/CANCELLED release the reservation.
model Withdrawal {
  id            String           @id @default(cuid())
  creatorId     String
  amount        Float
  // Human-readable request reference (e.g. "WD-A7K2QP9M"), auto-generated the
  // moment the creator submits. Distinct from `transactionReference` below,
  // which is the external bank/wallet transfer id an admin records only at
  // "Mark as Paid". This is the shared handle the creator, an admin and support
  // all use to talk about one request.
  referenceCode String           @unique
  // Denormalised payout channel — 'BANK' | 'ESEWA' | 'KHALTI' (PayoutMethodType).
  // Kept as a plain string for cheap filtering/display; the structured account
  // details live on the linked PayoutMethod and are snapshotted below.
  method        String
  status        WithdrawalStatus @default(PENDING)

  payoutMethodId String?
  payoutMethod   PayoutMethod? @relation(fields: [payoutMethodId], references: [id], onDelete: SetNull)
  // Account details captured at request time, so a later edit/delete of the
  // PayoutMethod never rewrites the record of where money was actually sent.
  payoutSnapshot Json?

  // Set by the admin on "Mark as Paid".
  transactionReference String?
  paymentDate          DateTime?
  screenshotUrl        String?
  processedByAdminId   String?
  adminNotes           String?
  // Set by the admin on "Reject".
  rejectionReason      String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([status, createdAt(sort: Desc)])
  @@map("withdrawals")
}

// A creator's saved payout account. Fixed set of channels (BANK/ESEWA/KHALTI) —
// deliberately NOT driven by the admin PaymentMethod catalog, which governs the
// business→platform payin side only.
model PayoutMethod {
  id            String           @id @default(cuid())
  creatorId     String
  type          PayoutMethodType
  label         String?
  // Account holder name — used by all three types.
  accountName   String
  // BANK only.
  bankName      String?
  branch        String?
  accountNumber String?
  // ESEWA / KHALTI only — the wallet ID or mobile number.
  walletId      String?
  isDefault     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@index([creatorId])
  @@map("payout_methods")
}

// Immutable creator-wallet ledger. Realized wallet balance = Σ COMPLETED rows
// signed by `direction`. Rows are append-only by convention — there is
// deliberately no update/delete method anywhere in the wallet module (same rule
// as audit.service.ts). Distinct from PaymentTransaction, which is the
// business-side campaign escrow ledger.
model WalletTransaction {
  id               String                  @id @default(cuid())
  creatorId        String
  type             WalletTransactionType
  direction        WalletDirection
  // Always positive; the sign is carried by `direction`.
  amount           Float
  status           WalletTransactionStatus @default(COMPLETED)
  description      String
  // e.g. 'application' | 'referral' | 'withdrawal' + the source row id. The
  // unique index below is the idempotency backstop: one CAMPAIGN_PAYOUT per
  // application, one WITHDRAWAL per withdrawal. NULL-reference rows (manual
  // ADJUSTMENT) stay unconstrained — Postgres treats NULLs as distinct.
  referenceType    String?
  referenceId      String?
  createdByAdminId String?
  createdAt        DateTime                @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([referenceId, type])
  @@index([creatorId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum PayoutMethodType {
  BANK
  ESEWA
  KHALTI
}

enum WalletTransactionType {
  CAMPAIGN_PAYOUT
  REFERRAL_REWARD
  REFERRAL_BONUS
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletDirection {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  COMPLETED
  REVERSED
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referredId   String         @unique
  code         String
  status       ReferralStatus @default(PENDING)
  linkedAt     DateTime       @default(now())
  expiresAt    DateTime
  completedAt  DateTime?
  rewardAmount Decimal        @default(500)
  reviewedBy   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  referrer CreatorProfile @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred CreatorProfile @relation("ReferralsReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model SocialAccount {
  id                  String           @id @default(cuid())
  // Exactly one of creatorProfileId/businessProfileId is set — which one determines
  // whose Social Accounts list this row appears in.
  creatorProfileId    String?
  businessProfileId   String?
  platform            String
  profileUrl          String
  followers           Int              @default(0)
  // True once profileUrl/followers were pulled directly from the platform's API via
  // OAuth (e.g. YouTube) rather than typed in by the creator.
  connectedViaOAuth   Boolean          @default(false)
  // The platform's own user/channel id — lets a reconnect find and update the same
  // row instead of erroring on the creatorProfileId+platform unique constraint.
  platformUserId      String?
  avatarUrl           String?
  // Persisted so the follower/subscriber count can keep refreshing itself (manual
  // "Refresh" tap + the scheduled job in jobs/refreshSocialFollowers.ts) long after
  // the connect flow's own short-lived token would otherwise have expired.
  // Never exposed in any DTO — see creator.dto.ts's toSocialAccountDto allowlist.
  accessToken         String?
  refreshToken        String?
  tokenExpiresAt      DateTime?
  // Distinguishes HOW this row was connected when the platform alone is ambiguous —
  // 'instagram' can come from either the Facebook-Page-linked flow or Instagram's own
  // direct login, and each stores a token from a different API with a different
  // refresh mechanism (see creator.service.ts refreshAllSocialAccountFollowers).
  oauthConnectionType String?
  // Last time `followers` was actually re-fetched from the platform — distinct from
  // `updatedAt`, which also changes on unrelated edits (e.g. connectedViaOAuth flips).
  followersSyncedAt   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  creatorProfile      CreatorProfile?  @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  businessProfile     BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([creatorProfileId, platform])
  @@unique([businessProfileId, platform])
  @@map("social_accounts")
}

// Tracks distinct brand views of a creator profile — capped to one row per
// business per creator per 24h at the service layer (see analytics.service.ts
// recordProfileView), not a DB constraint, since the window is time-based.
model ProfileView {
  id         String          @id @default(cuid())
  creatorId  String
  businessId String
  viewedAt   DateTime        @default(now())
  creator    CreatorProfile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([creatorId, viewedAt])
  @@index([creatorId, businessId, viewedAt])
  @@map("profile_views")
}

model BusinessProfile {
  id                       String               @id @default(cuid())
  userId                   String               @unique
  businessName             String?
  description              String?
  logoUrl                  String?
  coverImageUrl            String?
  website                  String?
  categories               String[]
  panNo                    String?
  location                 String?
  locationLat              Float?
  locationLng              Float?
  phone                    String?
  isVerified               Boolean              @default(false)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  allowDirectMessages      Boolean              @default(true)
  hideContactDetails       Boolean              @default(false)
  showPublicProfile        Boolean              @default(true)
  // §61 — social links are shown on the public profile by default; hiding
  // them doesn't remove them from the account, just from what businesses/
  // providers browsing each other's profiles can see.
  hideSocialLinks          Boolean              @default(false)
  paymentMethods           String[]             @default([])
  referralCode             String?              @unique
  socialLinks              Json                 @default("{}")
  presenceServices         String[]             @default([])
  defaultPlatforms         String[]             @default([])
  defaultCreatorCategories String[]             @default([])
  defaultBudgetRange       String?
  panDocUrl                String?
  panDocStatus             DocumentStatus       @default(NONE)
  panDocUploadedAt         DateTime?
  companyRegDocUrl         String?
  companyRegDocStatus      DocumentStatus       @default(NONE)
  companyRegDocUploadedAt  DateTime?
  // INDIVIDUAL service takers verify with a personal identity document
  // (citizenship, national ID or personal PAN) — they have no company
  // registration, so requiring panDoc + companyRegDoc the way an ORGANIZATION
  // does would leave them permanently unverifiable. ORGANIZATION profiles
  // leave this null and use the two fields above instead.
  identityDocUrl           String?
  identityDocStatus        DocumentStatus       @default(NONE)
  identityDocUploadedAt    DateTime?
  verificationRejectReason String?
  verificationRejectedAt   DateTime?
  province                 String?
  district                 String?
  city                     String?
  area                     String?
  address                  String?
  locationVisibility       LocationVisibility   @default(CITY)
  businessSize             BusinessSize?
  // Collected as the first step of business onboarding, right after signup.
  representingType         RepresentingType?
  // ORGANIZATION-only, collected on the same step as businessName. Never asked
  // of an INDIVIDUAL hirer, so both stay null on those profiles.
  organizationType         OrganizationType?
  // Free text, only meaningful when organizationType is OTHER.
  organizationTypeOther    String?
  // Who to reach at the organization — distinct from businessName, and from
  // the account holder's User.name (an office manager may run the account).
  contactPersonName        String?
  // Collected on the last step of business onboarding, alongside
  // defaultCreatorCategories — see BusinessPurpose for what drives what.
  purpose                  BusinessPurpose?
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns                Campaign[]
  conversations            Conversation[]       @relation("BusinessConversations")
  favoritedBy              FavoriteBusiness[]
  savedCreators            SavedCreator[]
  sentInvitations          CampaignInvitation[]
  referralsMade            BusinessReferral[]   @relation("BizReferralsMade")
  referralsReceived        BusinessReferral?    @relation("BizReferralsReceived")
  profileViews             ProfileView[]
  socialAccounts           SocialAccount[]
  paymentTransactions      PaymentTransaction[]
  contracts                Contract[]
  aiConversations          AiConversation[]
  serviceRequests          ServiceRequest[]

  @@index([isVerified])
  @@map("business_profiles")
}

model BusinessReferral {
  id           String         @id @default(cuid())
  referrerId   String
  referredId   String         @unique
  code         String
  status       ReferralStatus @default(PENDING)
  linkedAt     DateTime       @default(now())
  expiresAt    DateTime
  completedAt  DateTime?
  rewardAmount Decimal        @default(500)
  reviewedBy   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  referrer BusinessProfile @relation("BizReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred BusinessProfile @relation("BizReferralsReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("business_referrals")
}

model Campaign {
  id                    String                @id @default(cuid())
  businessId            String
  title                 String
  description           String
  template              String?
  featureImageUrl       String?
  category              String
  goals                 Json                  @default("[]")
  platforms             String[]              @default([])
  minFollowers          Int                   @default(0)
  contentType           String
  deliverables          String
  deadline              DateTime
  location              String?
  locationLat           Float?
  locationLng           Float?
  locationType          LocationType          @default(ONSITE)
  budgetMin             Float
  budgetMax             Float
  paymentType           String
  status                CampaignStatus        @default(ACTIVE)
  // Admin soft-delete (see AdminRepository.softDeleteCampaignCascade) — the
  // campaign row itself is kept (audit trail), but every consumer-facing
  // query (findMany/findManySearch/findNearby/findById/findByBusinessId in
  // CampaignRepository) excludes it, and Applications/CampaignRequirement/
  // CampaignInvitation rows are hard-deleted at the same time regardless of
  // their status. Independent of `status` above — a deleted campaign keeps
  // whatever status it had when removed.
  deletedAt             DateTime?
  // Snapshotted from the platform.commission admin setting at creation time,
  // so later changes to the global rate never retroactively affect an
  // already-posted event. Null on campaigns created before this field existed.
  // Added on top of what the business pays — creators always receive the
  // full proposedRate; the platform fee is the business's cost, not a
  // deduction from the creator's payout.
  commissionRate        Float?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  isFeatured            Boolean               @default(false)
  creatorsNeeded        Int                   @default(1)
  campaignType          CampaignType          @default(PAID_CAMPAIGN)
  capacity              Int?
  eventDate             DateTime?
  venue                 String?
  benefits              Json                  @default("[]")
  eventStatus           EventStatus           @default(OPEN)
  paymentStatus         PaymentStatus         @default(UNPAID)
  paidAt                DateTime?
  paymentMethod         String?
  objective             String?
  contentGuidelines     String[]              @default([])
  targetAudience        String[]              @default([])
  hashtags              String[]              @default([])
  sampleCaption         String?
  approvalRequirements  String?
  aiGenerated           Boolean               @default(false)
  aiPrompt              String?
  aiSuggestedCategories String[]              @default([])
  aiSuggestedPlatforms  String[]              @default([])
  aiNeedsInputFields    String[]              @default([])
  // AI-determined (or business-corrected) completion type for the simple
  // single-category case — null until classified. Multi-requirement
  // campaigns use each CampaignRequirement's own completionType instead.
  completionType        CompletionType?
  completionReason      String?
  applications          Application[]
  business              BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations         Conversation[]
  invitations           CampaignInvitation[]
  paymentTransactions   PaymentTransaction[]
  contracts             Contract[]
  requirements          CampaignRequirement[]
  shortlistedBy         ShortlistedCampaign[]

  // Maintained by a Postgres trigger (see migration add_campaign_fulltext_search) —
  // Prisma can't type tsvector, so it's never written through the client, only
  // read via $queryRaw for full-text search. GIN index + pg_trgm indexes on
  // title/category live in that migration's raw SQL too, not modeled here.
  searchVector Unsupported("tsvector")?

  @@index([businessId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([campaignType, status])
  @@index([locationLat, locationLng])
  @@index([deletedAt])
  @@map("campaigns")
}

model Application {
  id                   String                  @id @default(cuid())
  campaignId           String
  // Set only for campaigns using CampaignRequirement (multi-role campaigns) —
  // null for the simple single-category campaigns that predate it and remain
  // the common case. See the two-part uniqueness note below @@index.
  requirementId        String?
  creatorId            String
  coverLetter          String
  proposedRate         Float
  timeline             String
  socialHandles        Json                    @default("{}")
  portfolioUrl         String?
  status               ApplicationStatus       @default(PENDING)
  workStatus           WorkStatus              @default(NONE)
  workNote             String?
  revisionRequestedAt  DateTime?
  submittedAt          DateTime?
  deliverableUrls      String?
  // Up to 3 entries: { publicId, url, thumbnailUrl, durationSec, format, sizeBytes, label, uploadedAt }.
  // Appended via a conditional SQL update capped at 3 (see CampaignRepository.appendDeliverableVideo)
  // rather than a plain read-modify-write, since two uploads completing near-simultaneously would
  // otherwise race and silently drop one. Cleared (with the underlying Cloudinary assets deleted) on
  // requestRevision — see CampaignService.requestRevision.
  deliverableVideos    Json                    @default("[]")
  // Up to 10 entries: { id, publicId, url, fileType, originalFileName, mimeType, sizeBytes, uploadedAt }.
  // Images/PDF/DOCX are <=5MB and proxied through this server (multer), unlike
  // deliverableVideos' direct-to-Cloudinary signed flow. Cleared alongside
  // deliverableVideos on requestRevision.
  deliverableFiles     Json                    @default("[]")
  paymentStatus        PaymentStatus           @default(UNPAID)
  paidAt               DateTime?
  // esewa | khalti | fonepay — set once payForApplication (mock) or a real
  // gateway (Khalti) actually completes the payment.
  paymentMethod        String?
  // Khalti's payment identifier for the most recent initiate call — overwritten
  // on every retry so only the latest attempt's callback can complete the
  // payment (an older, abandoned pidx can never be replayed to mark this paid).
  khaltiPidx           String?                 @unique
  // eSewa's transaction_uuid for the most recent initiate call — same
  // overwrite-on-retry role as khaltiPidx above, verified against eSewa's
  // signed redirect + status-check API in confirmEsewaPayment.
  esewaTransactionUuid String?                 @unique
  // Set only when an admin manually releases the held escrow payment —
  // brand approval no longer releases funds automatically, see approveWork().
  releasedAt           DateTime?
  releasedByAdminId    String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  campaign             Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requirement          CampaignRequirement?    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  creator              CreatorProfile          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  reviews              Review[]
  paymentTransactions  PaymentTransaction[]
  revisionNotes        RevisionNote[]
  assignments          ApplicationAssignment[]
  contract             Contract?

  // True uniqueness is enforced by two hand-written partial indexes, not a
  // plain @@unique — Prisma can't express "unique except when null" and a
  // naive @@unique([campaignId, creatorId, requirementId]) would silently
  // stop enforcing one-application-per-campaign for every requirementId-null
  // (i.e. every simple, non-multi-role) campaign, since Postgres treats each
  // NULL as distinct in a composite unique index. See the migration.sql this
  // schema change produces for the actual:
  //   UNIQUE (campaignId, creatorId) WHERE requirementId IS NULL
  //   UNIQUE (campaignId, creatorId, requirementId) WHERE requirementId IS NOT NULL
  // This plain index exists only for query performance, not uniqueness.
  @@index([campaignId, creatorId])
  @@index([requirementId])
  @@index([creatorId])
  @@index([creatorId, createdAt(sort: Desc)])
  @@index([campaignId, status])
  @@map("applications")
}

// One role-slot within a multi-role campaign (§ "Campaign → Requirements →
// Applications → Collaboration" architecture) — e.g. a restaurant-launch
// campaign might have "1 Photographer @ NPR 10,000" and "2 Content Creators
// @ NPR 15,000 each" as two separate CampaignRequirement rows. Purely
// additive/opt-in: a Campaign with zero requirements behaves exactly as
// every campaign does today (single category/budget/deadline on Campaign
// itself, Application.requirementId stays null). Selected-count ("1/2
// filled") is deliberately NOT a stored counter — compute it live via
// Application.count({ requirementId, status: ACCEPTED }) vs quantity, same
// live-compute convention as Category.countUsage, to avoid drift.
//
// NOT YET WIRED: campaign.service.ts's capacity-enforcement (auto-reject
// pending + close campaign when a slot fills) is whole-campaign-scoped today
// and does not know about per-requirement fill — that's deliberately a
// separate follow-up task once real UI needs it, not part of this schema
// change. Do not assume accepting into a requirement behaves correctly yet.
model CampaignRequirement {
  id               String                @id @default(cuid())
  campaignId       String
  categoryId       String
  quantity         Int                   @default(1)
  budgetType       RequirementBudgetType @default(FIXED)
  budgetFixed      Float?
  budgetMin        Float?
  budgetMax        Float?
  deliverables     String?
  // Free-text brief of what this role should actually do — only meaningful
  // for non-Content-Creator roles (which use `deliverables` instead).
  description      String?
  // §42 — expected file format(s) for this role's deliverables, e.g.
  // ["JPG", "MP4"]. Free-form strings (not an enum) so "Other: ..." values
  // typed by the business pass through untouched, same convention as
  // Category/Provider "Other" text fields elsewhere in this schema.
  format           String[]              @default([])
  deadline         DateTime?
  // Per-role completion type — a multi-role campaign can freely mix e.g. a
  // DJ (SERVICE) and a Photographer (DELIVERABLE) requirement. Null until
  // classified, same convention as Campaign.completionType.
  completionType   CompletionType?
  completionReason String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  applications Application[]

  @@index([campaignId])
  @@index([categoryId])
  @@map("campaign_requirements")
}

enum RequirementBudgetType {
  FIXED
  RANGE
  NEGOTIABLE
}

// Append-only history of every revision request a business has sent for an
// application — Application.workNote/revisionRequestedAt only ever hold the
// latest value (and workNote is dual-purpose, also written by submitWork()
// for the creator's own submission note), so this is the source of truth for
// showing the creator/business the full back-and-forth, newest first.
model RevisionNote {
  id            String      @id @default(cuid())
  applicationId String
  note          String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt(sort: Desc)])
  @@map("revision_notes")
}

// One row per real money movement: a business escrowing funds for an accepted
// creator (ESCROW_IN) or the platform releasing that escrow to the creator once
// the project is complete (PAYOUT). Written at the same call sites that already
// flip Application.paymentStatus (payForApplication / releaseApplicationPayment)
// — this is an append-only ledger, not a replacement for those status fields.
model PaymentTransaction {
  id            String                 @id @default(cuid())
  type          PaymentTransactionType
  amount        Float
  // esewa | khalti | fonepay — null until a real payment gateway is wired up;
  // the column exists now so that integration doesn't need another migration.
  method        String?
  applicationId String
  campaignId    String
  businessId    String
  // Set on PAYOUT only — ESCROW_IN's counterparty is the platform, not a creator.
  creatorId     String?
  // Set on PAYOUT only — the admin who released it (mirrors Application.releasedByAdminId).
  adminId       String?
  createdAt     DateTime               @default(now())

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator     CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([campaignId])
  @@index([createdAt(sort: Desc)])
  @@map("payment_transactions")
}

enum PaymentTransactionType {
  ESCROW_IN
  PAYOUT
}

// One row per rater per completed application — a creator and a business can
// each leave one review of the other once work is fully COMPLETED (see
// completeProject() in campaign.service.ts, the terminal workStatus).
model Review {
  id            String      @id @default(cuid())
  applicationId String
  fromUserId    String
  toUserId      String
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromUser      User        @relation("ReviewFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User        @relation("ReviewTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([applicationId, fromUserId])
  @@index([toUserId])
  @@map("reviews")
}

model Conversation {
  id                String             @id @default(cuid())
  creatorId         String
  // Second creator side for creator<->creator conversations — null for
  // creator<->business rows (businessId set instead). When set, canonical
  // ordering is enforced at the repository layer: creatorId always holds the
  // lexicographically smaller of the two creator-profile ids, creatorId2 the
  // larger, so the pair is deterministic regardless of who initiates.
  creatorId2        String?
  businessId        String?
  campaignId        String?
  createdAt         DateTime           @default(now())
  status            ConversationStatus @default(PENDING)
  // True when ACCEPTED was set automatically by a proposal-accept (no real chat
  // request/accept happened) — such conversations revert to PENDING once the
  // project completes, rather than staying open indefinitely.
  autoAccepted      Boolean            @default(false)
  requestMessage    String?
  lastMessageAt     DateTime?
  businessSeenAt    DateTime?
  creatorSeenAt     DateTime?
  creator2SeenAt    DateTime?
  // "Delete conversation" is per-side only (like Messenger/Instagram) — hiding it
  // from one participant's inbox never affects the other's copy. Both flags reset
  // to false the moment a new message is sent, so the thread reappears for
  // whichever side had hidden it.
  hiddenForCreator  Boolean            @default(false)
  hiddenForBusiness Boolean            @default(false)
  hiddenForCreator2 Boolean            @default(false)
  business          BusinessProfile?   @relation("BusinessConversations", fields: [businessId], references: [id], onDelete: Cascade)
  creator2          CreatorProfile?    @relation("Creator2Conversations", fields: [creatorId2], references: [id], onDelete: Cascade)
  campaign          Campaign?          @relation(fields: [campaignId], references: [id])
  creator           CreatorProfile     @relation("CreatorConversations", fields: [creatorId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@unique([creatorId, businessId])
  @@unique([creatorId, creatorId2])
  // Covers the inbox list query (messaging.repository.ts findConversationsByCreator/
  // findConversationsByBusiness): filter by side + hidden flag, ordered by
  // lastMessageAt. The old standalone @@index([businessId]) is superseded — a
  // composite index still serves businessId-only lookups via its leading column.
  @@index([creatorId, hiddenForCreator, lastMessageAt(sort: Desc)])
  @@index([creatorId2, hiddenForCreator2, lastMessageAt(sort: Desc)])
  @@index([businessId, hiddenForBusiness, lastMessageAt(sort: Desc)])
  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                     String            @id @default(cuid())
  conversationId         String
  senderId               String
  content                String
  type                   MessageType       @default(TEXT)
  attachmentUrl          String?
  attachmentName         String?
  attachmentThumbnailUrl String? // Cloudinary-derived jpg poster frame — VIDEO only
  attachmentDurationSec  Int?
  attachmentWidth        Int?
  attachmentHeight       Int?
  attachmentSize         Int? // bytes
  attachmentFormat       String?
  // VIDEO only — nullable rather than defaulted so existing rows (all
  // pre-dating this field) read back as null, treated as READY by the DTO
  // layer rather than a real "still processing" state.
  attachmentStatus       VideoAssetStatus?
  // VOICE only — CSV of ~28 normalized (0-1) bar heights captured live from
  // expo-audio metering during recording, so the playback bubble renders the
  // actual recorded waveform instead of a generic placeholder.
  attachmentWaveform     String?
  createdAt              DateTime          @default(now())
  // "Delete for everyone" (sender-only, no time limit) — the row is kept so
  // history/pagination doesn't shift, but the content is tombstoned in the DTO.
  deletedAt              DateTime?
  deletedBy              String?
  // Set when the sender edits the text after sending — the DTO surfaces this
  // as an "Edited" label, matching the WhatsApp/Instagram convention.
  editedAt               DateTime?
  // "Delete for me" — hides the message from one side's view without touching
  // the other participant's copy or the underlying content.
  hiddenForCreator       Boolean           @default(false)
  hiddenForBusiness      Boolean           @default(false)
  hiddenForCreator2      Boolean           @default(false)
  conversation           Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                 User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

// AI Assistant for Brands (Phase 1) — a separate conversational thread between
// a business user and the assistant, distinct from Conversation/Message above
// (which are the human creator<->business chat).
model AiConversation {
  id         String          @id @default(cuid())
  userId     String
  businessId String
  language   String          @default("en")
  title      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages   AiMessage[]
  actionLogs AiActionLog[]

  @@index([businessId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  toolName       String?
  toolPayload    Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("ai_messages")
}

// Write-only audit trail of every tool call the assistant makes — used for
// debugging/support ("why did the AI say X") and future analytics (TR-10),
// not read back by any client in Phase 1.
model AiActionLog {
  id             String         @id @default(cuid())
  conversationId String
  userId         String
  action         String
  input          Json
  result         String
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("ai_action_logs")
}

model LegalSection {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String
  icon      String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_sections")
}

// Admin-editable base contract text per campaign type — {{placeholder}} tokens
// (see contract.service.ts's TOKENS) get substituted with per-deal values when
// a Contract is generated. One row per CampaignType, lazily created with a
// built-in default body on first use if the admin hasn't edited one yet.
model ContractTemplate {
  id           String       @id @default(cuid())
  campaignType CampaignType @unique
  title        String       @default("Creator Collaboration Agreement")
  body         String
  updatedAt    DateTime     @updatedAt
  createdAt    DateTime     @default(now())

  @@map("contract_templates")
}

enum ContractStatus {
  PENDING_BUSINESS
  EXECUTED
  VOID
}

// A per-application contract, snapshotted from ContractTemplate + the deal's
// terms at the moment the creator submits the proposal (creatorAgreedAt is
// set immediately since submission itself is gated behind agreeing to these
// terms — see submit-proposal.tsx). businessAgreedAt/status flip to EXECUTED
// when the business accepts (see campaign.service.ts updateApplicationStatus).
// Frozen once created — later edits to the admin template or the campaign
// itself never retroactively change an already-created contract.
model Contract {
  id               String         @id @default(cuid())
  applicationId    String         @unique
  campaignId       String
  businessId       String
  creatorId        String
  title            String
  filledBody       String
  // Structured snapshot of the deal terms (price, deadline, deliverables,
  // timeline, platforms, benefits, etc.) — see contract.service.ts buildTerms.
  terms            Json
  status           ContractStatus @default(PENDING_BUSINESS)
  creatorAgreedAt  DateTime       @default(now())
  businessAgreedAt DateTime?
  pdfUrl           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator     CreatorProfile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model FaqArticle {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_articles")
}

model SupportRequest {
  id             String   @id @default(cuid())
  userId         String?
  // Set only for anonymous submissions (e.g. the public landing-page contact
  // form) — logged-in submissions identify the sender via `user` instead.
  guestName      String?
  guestEmail     String?
  topic          String
  message        String
  status         String   @default("OPEN")
  // Cloudinary URLs — up to 3, uploaded via POST /api/support/attachments
  // before the request itself is submitted.
  attachmentUrls String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id])

  @@map("support_requests")
}

model IssueReport {
  id             String   @id @default(cuid())
  userId         String?
  type           String
  description    String
  status         String   @default("OPEN")
  // Cloudinary URLs — up to 3, uploaded via POST /api/support/attachments
  // before the report itself is submitted.
  attachmentUrls String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id])

  @@map("issue_reports")
}

model HelpArticle {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("help_articles")
}

