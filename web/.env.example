VITE_SENTRY_DSN=

# Google Maps JS API key, used by the landing page's creator-connection map.
# Restrict it in Google Cloud Console to your domain(s) and the Maps
# JavaScript API only.
VITE_GOOGLE_MAPS_API_KEY=

# Optional, build-time only (not VITE_-prefixed so they never reach the client bundle).
# Set these to enable automatic sourcemap upload to Sentry during `vite build`.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
