VITE_SENTRY_DSN=

# Google Maps JS API key, used by the landing page's creator-connection map.
# Restrict it in Google Cloud Console to your domain(s) and the Maps
# JavaScript API only.
VITE_GOOGLE_MAPS_API_KEY=

# Facebook App ID for the creator profile's "Connect Facebook/Instagram" flow
# (Facebook Login JS SDK — public client id, safe to expose). Requires this
# app's domain to be added under Settings → Basic → App Domains in the
# Facebook Developer Console. Same app id as mobile's EXPO_PUBLIC_FACEBOOK_APP_ID.
VITE_FACEBOOK_APP_ID=

# Optional, build-time only (not VITE_-prefixed so they never reach the client bundle).
# Set these to enable automatic sourcemap upload to Sentry during `vite build`.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
