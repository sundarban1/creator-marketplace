# Local-only overrides (gitignored). Wins over .env.development in Expo SDK 56.
# Android emulator cannot reach the host LAN IP (192.168.1.94) reliably — it
# reaches the dev machine via the NAT alias 10.0.2.2. Delete this file when
# running on iOS simulator or a physical device.
EXPO_PUBLIC_API_BASE=http://10.0.2.2:3000
