{
  "expo": {
    "name": "Kolab",
    "slug": "kolab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "kolab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sundarban.kolab",
      "supportsTablet": false,
      "requireFullScreen": true,
      "usesAppleSignIn": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAJrdBTZyJH0Sxku7uG-_V4x5lSv4xWii0"
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "fb1740519673635792"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.543768819635-fuslrtr8mt6bmi2jslc3h3hcqg4drhdk"
            ]
          }
        ],
        "FacebookAppID": "1740519673635792",
        "FacebookDisplayName": "Kolab",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAJrdBTZyJH0Sxku7uG-_V4x5lSv4xWii0"
        }
      },
      "package": "com.sundarban.kolab",
      "googleServicesFile": "./google-services.json",
      "scheme": "com.sundarban.kolab"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kolab to access your location to find nearby campaigns."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Kolab to use Face ID to quickly and securely unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6d28d9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kolab to access your photos to update your profile picture.",
          "cameraPermission": "Allow Kolab to use your camera to take a profile photo."
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Kolab to save your event invitation to your photo library.",
          "savePhotosPermission": "Allow Kolab to save your event invitation to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Kolab to use your microphone to record voice messages for the AI assistant."
        }
      ],
      "@sentry/react-native/expo",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# react-native-background-upload / net.gotev uploadservice — reflection-based\n# task dispatch inside the upload service. Without these keeps, R8 strips/renames\n# the classes in release builds and the native upload silently emits no\n# progress/completed/error events (voice + video chat uploads hang at 0%).\n-keep class net.gotev.uploadservice.** { *; }\n-keep class com.vydia.RNUploader.** { *; }\n-dontwarn net.gotev.uploadservice.**\n-keep class net.gotev.** { *; }"
          }
        }
      ],
      "./plugins/withFixMapsPodfile.js",
      "./plugins/withDisableFirebaseSPM.js",
      "./plugins/withUploadServiceForegroundType.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77b46836-b5cc-408d-abba-c6a908fa3e43"
      }
    },
    "owner": "sundarban"
  }
}
